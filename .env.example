# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DATABASE=restaurant_delice
MONGODB_COLLECTION_DOCUMENTS=documents
MONGODB_COLLECTION_CHUNKS=chunks
MONGODB_COLLECTION_ORDERS=orders
MONGODB_COLLECTION_CONVERSATIONS=conversations
MONGODB_COLLECTION_MESSAGES=messages
MONGODB_COLLECTION_COUNTERS=counters
MONGODB_VECTOR_INDEX=vector_index
MONGODB_TEXT_INDEX=text_index

# OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_KITCHEN_CHAT_ID=-5053968395

# Google Drive
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_SYNC_INTERVAL_MINUTES=15
DRIVE_SYNC_MAX_DELETE_RATIO=0.5

# Reranking
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=10

# Photos des plats
PHOTOS_ENABLED=true
PHOTOS_MAX_DISHES=4
PHOTOS_CAPTION_SUFFIX=
DRIVE_PHOTOS_CATALOGUE_NAME=photos

# Divers
MEMORY_MAX_MESSAGES=50
CHUNK_MAX_TOKENS=512
